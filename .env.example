# Copy to .env and fill ONE provider. Priority if several are set: Claude > OpenAI-compatible > Gemini (AI_PROVIDER=claude|openai|gemini forces one)

# --- A) Fully free + self-hosted: Ollama (docker compose --profile ollama up) ---
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3.1
# LLM_API_KEY=            # not needed for Ollama

# --- B) Free cloud: Google Gemini free tier (https://aistudio.google.com/apikey) ---
# GEMINI_API_KEY=

# --- C) Free cloud: Groq / OpenRouter (any OpenAI-compatible API) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=

# --- D) Paid, best quality: Claude (https://console.anthropic.com) ---
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-haiku-5-5   # cheaper than the default claude-opus-5-5

PORT=3000
