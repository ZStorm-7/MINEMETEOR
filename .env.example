# Copy to .env only if you want something other than the built-in free Pollinations AI.
# Priority if several are set: Claude > GROQ_API_KEY / LLM_BASE_URL > Gemini > Pollinations (built in) (AI_PROVIDER=claude|openai|gemini forces one)

# --- A) DEFAULT - no signup, no key: Pollinations (free public AI). It is built in: leave everything below empty/commented and it just works. ---
#     Slow (10-190 s per answer) and not perfect, but it uses the wiki tools. It automatically uses the calmer "plain" style.
# LLM_BASE_URL=          # leave unset to use Pollinations
# FINDCRAFT_STYLE=plain  # or "emoji" for the original emoji-heavy replies
# LLM_FORCE_LOOKUP=off   # (default on) free models must check the wiki first; "off" disables that

# --- B) RECOMMENDED upgrade - Groq, free, 1-minute signup, no card: fast and far more accurate than Pollinations ---
#     1) https://console.groq.com/keys -> Create API Key   2) paste it below   3) restart. That is all (model defaults to openai/gpt-oss-120b).
# GROQ_API_KEY=gsk_...

# --- C) Free with signup: OpenRouter ":free" models - https://openrouter.ai/keys ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-oss-120b:free
# LLM_API_KEY=sk-or-...

# --- D) Fully self-hosted: Ollama (docker compose --profile ollama up). Needs a GPU to be useful. ---
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5:14b

# --- E) Free cloud: Google Gemini free tier - https://aistudio.google.com/apikey ---
#     Fast (1-4 s) but a SMALL free quota (~5 questions/minute). Uses gemini-2.5-flash; set GEMINI_MODEL to change it.
# GEMINI_API_KEY=

# --- F) Paid, best quality: Claude - https://console.anthropic.com ---
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-haiku-5-5   # cheaper than the default claude-opus-5-5

PORT=3000
