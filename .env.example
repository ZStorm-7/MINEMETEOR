# Copy to .env and fill ONE provider. Priority if several are set: Claude > OpenAI-compatible > Gemini (AI_PROVIDER=claude|openai|gemini forces one)

# --- A) No signup at all: Pollinations (free public AI, gpt-oss-20b). Works today, slow (15-90s), sometimes wrong. ---
LLM_BASE_URL=https://text.pollinations.ai/openai
LLM_MODEL=openai
FINDCRAFT_STYLE=plain      # fewer emojis: small models are MUCH more accurate this way

# --- B) Free with a 1-minute signup, no card: Groq (fast, bigger models) - https://console.groq.com/keys ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=gsk_...

# --- C) Free with signup: OpenRouter ":free" models - https://openrouter.ai/keys ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-oss-120b:free
# LLM_API_KEY=sk-or-...

# --- D) Fully self-hosted: Ollama (docker compose --profile ollama up). Needs a GPU to be useful. ---
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5:14b

# --- E) Free cloud: Google Gemini free tier - https://aistudio.google.com/apikey ---
# GEMINI_API_KEY=

# --- F) Paid, best quality: Claude - https://console.anthropic.com ---
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-haiku-5-5   # cheaper than the default claude-opus-5-5

PORT=3000
